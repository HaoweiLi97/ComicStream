{
  "name": "comicstream",
  "description": "CSTR is a random-access comic file format. ComicStream includes a CBZ converter and a browser reader that streams WebP chunks and page thumbnails over HTTP Range.",
  "keywords": [
    "cstr",
    "file-format",
    "comic-reader",
    "manga",
    "webtoon",
    "cbz-converter",
    "webp",
    "http-range",
    "random-access",
    "page-thumbnails"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node serve.mjs",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
